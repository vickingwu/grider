{
  "name": "grider-frontend",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "imports": {
    "@/*": [
      "./src/*"
    ],
    "@shared/*": [
      "./src/shared/*"
    ],
    "@features/*": [
      "./src/features/*"
    ],
    "@pages/*": [
      "./src/pages/*"
    ],
    "@app/*": [
      "./src/app/*"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "check-unused": "node scripts/check-unused-imports.js",
    "clean": "rm -rf dist node_modules/.cache",
    "build:engine": "node scripts/bundle-backend.mjs && node scripts/fetch-wheels.mjs",
    "capture:fixtures": "node scripts/run-python.mjs -m tests.browser.capture_fixtures",
    "test:engine": "npm run capture:fixtures && npm run build:engine && node --test \"tests/engine/*.test.mjs\"",
    "probe:pyodide": "node scripts/probe-flask-pyodide.mjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fflate": "0.8.3",
    "playwright": "1.58.2",
    "postcss": "^8.4.32",
    "pyodide": "0.29.5",
    "tailwindcss": "^3.3.6",
    "terser": "^5.44.0",
    "vite": "^5.0.8"
  }
}
